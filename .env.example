# ============================================================
# 环境变量模板：将本文件复制为 .env 并填好真实值，再启动服务。
#   cp .env.example .env
# 请把示例占位符全部替换为强随机值，切勿带着示例值上线。
# 本文件可公开提交；真实 .env 已被 .gitignore 忽略，切勿提交。
# ============================================================

# PostgreSQL（必填）：POSTGRES_PASSWORD 与 DATABASE_URL 里的密码必须一致
POSTGRES_DB=procurement
POSTGRES_USER=procurement
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql+asyncpg://procurement:change-this-database-password@postgres:5432/procurement

# 缓存（一般不用改）
REDIS_URL=redis://redis:6379/0

# JWT 签名密钥（必填）：
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=480

# 初始管理员（建议填写，首次启动自动创建；登录后请尽快改密）
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password

# 前端访问地址：默认 localhost；用 IP/域名访问时改成实际地址，如 http://192.168.1.100:8080
CORS_ORIGINS=http://localhost:8080

# 定时爬虫关键词（可选，逗号分隔；留空则 worker 空闲不抓取）
KAKAKU_KEYWORDS=
KAKAKU_INTERVAL=10
KAKAKU_ROUND_INTERVAL=3600
KAKAKU_MAX_ITEMS=20
CRAWL_OUTPUT_DIR=/data/crawl