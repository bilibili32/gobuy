POSTGRES_DB=procurement
POSTGRES_USER=procurement
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql+asyncpg://procurement:change-this-database-password@postgres:5432/procurement
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=480
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password
CORS_ORIGINS=http://localhost:8080

# 爬虫（価格.com）：逗号分隔的关键词，留空则 worker 空闲等待
KAKAKU_KEYWORDS=
KAKAKU_INTERVAL=10
KAKAKU_ROUND_INTERVAL=3600
CRAWL_OUTPUT_DIR=/data/crawl

