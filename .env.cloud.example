# 云服务器生产环境变量模板：复制为 .env.cloud 后填写真实值。
# .env.cloud 含数据库密码和 JWT 密钥，禁止提交或公开。

# 已解析到云服务器公网 IP 的域名
DOMAIN=procurement.example.com

POSTGRES_DB=procurement
POSTGRES_USER=procurement
POSTGRES_PASSWORD=change-me-strong-password
# 密码需与 POSTGRES_PASSWORD 一致；特殊字符请按 URL 规则编码
DATABASE_URL=postgresql+asyncpg://procurement:change-me-strong-password@postgres:5432/procurement

# 生成方式：openssl rand -hex 32
JWT_SECRET=change-me-64-hex
ACCESS_TOKEN_MINUTES=480

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# 可选：留空则 worker 不抓取；逗号分隔关键词
KAKAKU_KEYWORDS=
KAKAKU_INTERVAL=10
KAKAKU_ROUND_INTERVAL=3600
KAKAKU_MAX_ITEMS=20
CRAWL_OUTPUT_DIR=/data/crawl
