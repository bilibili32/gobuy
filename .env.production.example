# 生产环境变量模板：复制为 .env.production 并填写真实值。
# 所有值都应替换为强随机值，切勿使用示例值上线。

# 对外域名（必填）：Caddy 会自动为其申请并续期 Let's Encrypt 证书。
# 前提：该域名已解析到本服务器公网 IP，且 80/443 端口已放行。
DOMAIN=procurement.example.com

# PostgreSQL（必填，改成强随机密码；DATABASE_URL 里的密码要与之一致）
POSTGRES_DB=procurement
POSTGRES_USER=procurement
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://procurement:change-me-strong-password@postgres:5432/procurement

# JWT 签名密钥（必填，用 `openssl rand -hex 32` 生成）
JWT_SECRET=change-me-64-hex
ACCESS_TOKEN_MINUTES=480

# 初始管理员（可选但建议填写，首次启动自动创建；登录后请尽快改密）
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# 定时爬虫关键词（可选，逗号分隔；为空则不开定时抓取）
KAKAKU_KEYWORDS=
KAKAKU_INTERVAL=10
KAKAKU_ROUND_INTERVAL=3600
KAKAKU_MAX_ITEMS=20
